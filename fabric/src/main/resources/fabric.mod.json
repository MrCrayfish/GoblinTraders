{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_desc}",
    "authors": [ "${mod_author}" ],
    "contact": {
        "homepage": "${mod_homepage}",
        "sources": "${mod_source}",
        "issues": "${mod_issues}"
    },
    "license": "${mod_license}",
    "icon": "assets/${mod_id}/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.mrcrayfish.goblintraders.GoblinTraders"
        ],
        "client": [
            "com.mrcrayfish.goblintraders.client.ClientHandler"
        ],
        "fabric-datagen": [
            "com.mrcrayfish.goblintraders.GoblinDataGeneration"
        ]
    },
    "mixins": [
        "${mod_id}.fabric.mixins.json",
        "${mod_id}.common.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=21",
        "framework": ">=${framework_version}"
    },
    "custom": {
        "catalogue": {
            "banner": "assets/${mod_id}/banner.png",
            "background": "assets/${mod_id}/background.png"
        },
        "framework": {
            "containers": [
                "com.mrcrayfish.goblintraders.core"
            ],
            "configs": [
                "com.mrcrayfish.goblintraders.Config"
            ]
        }
    }
}
  